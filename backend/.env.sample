# PostgreSQL running locally (for example, via `docker compose up postgres`)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/todo_dev"

# Replace this value with a long, random secret in your local .env
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="24h"

PORT=5001
NODE_ENV="development"

# Global API rate limit: 100 requests per 15 minutes
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
